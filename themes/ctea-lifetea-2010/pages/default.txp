<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	<meta http-equiv="content-type" content="text/html; charset=utf-8" />
	<meta http-equiv="imagetoolbar" content="no" />
	<title><txp:page_title /></title>
	<txp:css format="link" media="screen" />
	<!-- squidfingers.com collapsible menu (Travis Beckham, 2003), kept as in the original -->
<script type="text/javascript" src="<txp:site_url />js/menu.js"></script>
</head>
<body>
<div id="container">
<div id="header">
&nbsp;
</div>
<div id="wrapper">
<txp:output_form form="sidebar" />

<div id="content">
<txp:if_individual_article>
<txp:article />
<p>
<txp:link_to_prev><txp:prev_title /></txp:link_to_prev>
<txp:link_to_next><txp:next_title /></txp:link_to_next>
</p>
<txp:else />
<txp:if_search>
<h3>Search results</h3>
<txp:article form="search_results" limit="20" />
<txp:else />
<txp:article limit="10" />
<p>
<txp:older>Previous</txp:older>
<txp:newer>Next</txp:newer>
</p>
</txp:if_search>
</txp:if_individual_article>
</div>
</div>
<div id="foot">
Design by <a href="http://www.ryanarrowsmith.com/">Ryan Arrowsmith</a> but feel free to share / Proudly powered by <a href="http://www.textpattern.com/">Textpattern</a>.
</div>
</div>
</body>
</html>
